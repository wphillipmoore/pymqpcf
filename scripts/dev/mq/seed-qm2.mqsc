* pymqpcf seed objects for QM2

DEFINE QLOCAL(PYMQPCF.DEAD.LETTER) REPLACE DEFPSIST(YES) DESCR('pymqpcf dead letter')
ALTER QMGR DEADQ(PYMQPCF.DEAD.LETTER)

DEFINE QLOCAL(PYMQPCF.QLOCAL) REPLACE DEFPSIST(YES) DEFPRESP(SYNC) DESCR('pymqpcf local queue')

DEFINE CHANNEL(PYMQPCF.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) REPLACE DESCR('pymqpcf svrconn')

* Cross-QM objects for multi-queue-manager examples

DEFINE QLOCAL(PYMQPCF.QM1.XMITQ) REPLACE DEFPSIST(YES) USAGE(XMITQ) DESCR('xmit queue to QM1')
DEFINE QREMOTE(PYMQPCF.REMOTE.TO.QM1) REPLACE RNAME('PYMQPCF.QLOCAL') RQMNAME('QM1') XMITQ(PYMQPCF.QM1.XMITQ) DESCR('remote queue to QM1')
DEFINE CHANNEL(QM2.TO.QM1) CHLTYPE(SDR) TRPTYPE(TCP) XMITQ(PYMQPCF.QM1.XMITQ) CONNAME('qm1(1414)') REPLACE DESCR('sender to QM1')
DEFINE CHANNEL(QM1.TO.QM2) CHLTYPE(RCVR) TRPTYPE(TCP) REPLACE DESCR('receiver from QM1')
