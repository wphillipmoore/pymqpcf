* pymqpcf seed objects for QM1

DEFINE QLOCAL(PYMQPCF.DEAD.LETTER) REPLACE DEFPSIST(YES) DESCR('pymqpcf dead letter')
ALTER QMGR DEADQ(PYMQPCF.DEAD.LETTER)

DEFINE QLOCAL(PYMQPCF.QLOCAL) REPLACE DEFPSIST(YES) DEFPRESP(SYNC) DESCR('pymqpcf local queue')
DEFINE QLOCAL(PYMQPCF.XMITQ) REPLACE DEFPSIST(YES) USAGE(XMITQ) DESCR('pymqpcf xmit queue')
DEFINE QREMOTE(PYMQPCF.QREMOTE) REPLACE RNAME('PYMQPCF.TARGET') RQMNAME('QM1') XMITQ(PYMQPCF.XMITQ) DESCR('pymqpcf remote queue')
DEFINE QALIAS(PYMQPCF.QALIAS) REPLACE TARGQ(PYMQPCF.QLOCAL) DESCR('pymqpcf alias queue')
DEFINE QMODEL(PYMQPCF.QMODEL) REPLACE DEFTYPE(TEMPDYN) DEFSOPT(SHARED) DESCR('pymqpcf model queue')

DEFINE TOPIC(PYMQPCF.TOPIC) REPLACE TOPICSTR('pymqpcf/topic') DESCR('pymqpcf topic')
DEFINE NAMELIST(PYMQPCF.NAMELIST) REPLACE NAMES(PYMQPCF.QLOCAL) DESCR('pymqpcf namelist')

DEFINE CHANNEL(PYMQPCF.SVRCONN) CHLTYPE(SVRCONN) TRPTYPE(TCP) REPLACE DESCR('pymqpcf svrconn')
DEFINE CHANNEL(PYMQPCF.SDR) CHLTYPE(SDR) TRPTYPE(TCP) XMITQ(PYMQPCF.XMITQ) CONNAME('localhost(1414)') REPLACE DESCR('pymqpcf sdr')
DEFINE CHANNEL(PYMQPCF.RCVR) CHLTYPE(RCVR) TRPTYPE(TCP) REPLACE DESCR('pymqpcf rcvr')

DEFINE LISTENER(PYMQPCF.LSTR) TRPTYPE(TCP) PORT(1415) CONTROL(QMGR) REPLACE DESCR('pymqpcf listener')
DEFINE PROCESS(PYMQPCF.PROC) REPLACE APPLICID('/bin/true') DESCR('pymqpcf process')

* Cross-QM objects for multi-queue-manager examples

DEFINE QLOCAL(PYMQPCF.QM2.XMITQ) REPLACE DEFPSIST(YES) USAGE(XMITQ) DESCR('xmit queue to QM2')
DEFINE QREMOTE(PYMQPCF.REMOTE.TO.QM2) REPLACE RNAME('PYMQPCF.QLOCAL') RQMNAME('QM2') XMITQ(PYMQPCF.QM2.XMITQ) DESCR('remote queue to QM2')
DEFINE CHANNEL(QM1.TO.QM2) CHLTYPE(SDR) TRPTYPE(TCP) XMITQ(PYMQPCF.QM2.XMITQ) CONNAME('qm2(1414)') REPLACE DESCR('sender to QM2')
DEFINE CHANNEL(QM2.TO.QM1) CHLTYPE(RCVR) TRPTYPE(TCP) REPLACE DESCR('receiver from QM2')
